        "id": "8cc9adb7"
      },
      "source": [
        "## Compare Different Values of K\n",
        "\n",
        "K is the number of nearest neighbours considered for classification. We test K = 1, 3, 5, 7 and 9 and compare their accuracy.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "34f786d6",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "34f786d6",
        "outputId": "117640f7-f99c-4ee4-dd87-9369f04a4e39"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "K = 1  Accuracy = 100.0 %\n",
            "K = 3  Accuracy = 100.0 %\n",
            "K = 5  Accuracy = 100.0 %\n",
            "K = 7  Accuracy = 100.0 %\n",
            "K = 9  Accuracy = 100.0 %\n"
          ]
        }
      ],
      "source": [
        "# Compare different K values\n",
        "k_values = [1, 3, 5, 7, 9]\n",
        "accuracies = []\n",
        "\n",
        "for k in k_values:\n",
        "    model = KNeighborsClassifier(n_neighbors=k)\n",
        "    model.fit(X_train, y_train)\n",
        "\n",
        "    prediction = model.predict(X_test)\n",
        "    score = accuracy_score(y_test, prediction)\n",
        "    accuracies.append(score)\n",
        "\n",
        "    print(\"K =\", k, \" Accuracy =\", round(score * 100, 2), \"%\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "bdf36b92",
      "metadata": {
        "id": "bdf36b92",
