      "source": [
        "# Plot test samples\n",
        "plt.figure(figsize=(7, 5))\n",
        "\n",
        "for class_no in np.unique(y_test):\n",
        "    plt.scatter(\n",
        "        X_test[y_test == class_no, 0],\n",
